# Credenciais da API do Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Configurações do Bot do Telegram
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_bot_aqui

# ID do canal/chat onde serão enviados os alertas automáticos da CVM
TELEGRAM_CHAT_ID_ALERTAS=id_do_canal_de_alertas_aqui

# ID do chat (grupo ou privado) para conversação com o bot (chat interativo RAG)
# Se deixado em branco, o bot responderá a qualquer usuário que mandar mensagem privada
TELEGRAM_CHAT_ID_CONVERSA=
