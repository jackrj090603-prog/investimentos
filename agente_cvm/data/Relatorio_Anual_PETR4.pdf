							$('.primary-menu li').each(function(){
									var keywords = $(this).find('a').text()
									$(this).find('a').attr('data-keywords', keywords)
							});
							$('.container > .ui-nav > .primary-menu > li > a').addClass('link-title');
							$('.container > .ui-nav > .primary-menu > li').each(function(){
									var sectionTitle = $(this).find('a').attr('title');
									$(this).prepend('<div class="section-title">' + sectionTitle + '</div>');
									$(this).find('.sub-menu').prepend('<li class="text-menu">' + sectionTitle + '</li>');
							});
							$('.menu-section .link-title[href=#]').remove();
							$('.menu-section .section-interface a').removeAttr('href');
